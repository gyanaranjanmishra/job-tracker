# Copy to .env.local and fill in. Never commit .env.local.
#
# Leave ANTHROPIC_API_KEY empty to run in demo mode: sample data, and ATS scores /
# cover letters from a local keyword matcher instead of Claude.
ANTHROPIC_API_KEY=

# Optional: Adzuna job search API (https://developer.adzuna.com). Other sources need no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: force demo mode even when an API key is set
# DEMO_MODE=true

# Optional: Claude model id (default claude-haiku-5-5)
CLAUDE_MODEL=
